# Copy to .env and fill in for local development.
# See ../README.md for the full localhost setup walkthrough.

# --- Database ---
# Local dev mode: SQLite, a plain file — nothing to install or run (see prisma/schema.prisma
# header note). Resolved relative to the prisma/ folder, so this creates prisma/dev.db.
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- App ---
PORT="3000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# --- Not needed for the local SQLite run — only relevant once you move to the full stack ---
# (see docker-compose.yml and README.md "Moving to the full Postgres/MinIO/Redis stack" section)
# DATABASE_URL="postgresql://tvet:tvet_dev_password@localhost:5432/tvet_lms?schema=public"
# MINIO_ENDPOINT="localhost"
# MINIO_PORT="9000"
# MINIO_USE_SSL="false"
# MINIO_ACCESS_KEY="tvet_minio_admin"
# MINIO_SECRET_KEY="tvet_minio_dev_password"
# MINIO_BUCKET="tvet-lms-resources"
# REDIS_URL="redis://localhost:6379"
